{
    // sbuild - VS Code Task Definitions (cross-platform)
    //
    // Copy this file to your project's .vscode/ directory:
    //   mkdir -p .vscode && cp editors/vscode/tasks.json .vscode/     (Linux / macOS)
    //   mkdir .vscode 2>nul & copy editors\vscode\tasks.json .vscode\ (Windows cmd)
    //
    // Usage: Ctrl+Shift+B for default build, Ctrl+Shift+P -> "Tasks: Run Task" for all tasks.
    // Tasks ending with "..." will prompt you for options via Quick Pick dialogs.
    //
    // Global platform blocks ("windows", "linux", "osx") prepend .venv to PATH
    // so sbuild and venv-installed tools (conan, cmake, etc.) are found automatically.
    // On Windows, cmd.exe is set as the default shell for interactive tasks.
    //
    // Recommended VS Code settings for faster task execution (add to .vscode/settings.json):
    //   "terminal.integrated.automationProfile.windows": {
    //       "path": "cmd.exe",
    //       "args": ["/d"]
    //   }
    "version": "2.0.0",
    "windows": {
        "options": {
            "env": {
                "VIRTUAL_ENV": "${workspaceFolder}\\.venv",
                "PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"
            },
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "linux": {
        "options": {
            "env": {
                "VIRTUAL_ENV": "${workspaceFolder}/.venv",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
            }
        }
    },
    "osx": {
        "options": {
            "env": {
                "VIRTUAL_ENV": "${workspaceFolder}/.venv",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
            }
        }
    },
    "tasks": [
        // =====================================================
        // QUICK ACCESS (no prompts, one-click)
        // =====================================================
        {
            "label": "Build: Debug",
            "type": "process",
            "command": "sbuild",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Build: Release",
            "type": "process",
            "command": "sbuild",
            "args": ["build", "--release"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Build: Debug (Clean First)",
            "type": "process",
            "command": "sbuild",
            "args": ["build", "--clean"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Build: Release (Clean First)",
            "type": "process",
            "command": "sbuild",
            "args": ["build", "--release", "--clean"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Rebuild: Debug (Full)",
            "type": "process",
            "command": "sbuild",
            "args": ["rebuild"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Rebuild: Release (Full)",
            "type": "process",
            "command": "sbuild",
            "args": ["rebuild", "--release"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Rebuild: All (Debug + Release)",
            "type": "process",
            "command": "sbuild",
            "args": ["rebuild", "--all"],
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Install: Debug",
            "type": "process",
            "command": "sbuild",
            "args": ["install"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Install: Release",
            "type": "process",
            "command": "sbuild",
            "args": ["install", "--release"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },
        {
            "label": "Package: Release NSIS (Fresh Build)",
            "type": "process",
            "command": "sbuild",
            "args": ["package", "--release", "--fresh", "--generator", "NSIS"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            },
            "runOptions": {
                "reevaluateOnRerun": false
            }
        },

        // =====================================================
        // INTERACTIVE (with prompts — "..." means Quick Pick)
        // =====================================================
        {
            "label": "Build...",
            "type": "shell",
            "command": "sbuild build ${input:configDRA} ${input:platform} ${input:arch} ${input:buildClean} ${input:verbose} ${input:jobs} ${input:buildNumber} --cmake-args \"${input:cmakeArgs}\"",
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Rebuild...",
            "type": "shell",
            "command": "sbuild rebuild ${input:configDRA} ${input:platform} ${input:arch} ${input:verbose} ${input:jobs} ${input:buildNumber} --cmake-args \"${input:cmakeArgs}\"",
            "group": "build",
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean...",
            "type": "shell",
            "command": "sbuild clean ${input:configDR} ${input:platform} ${input:arch}",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Configure...",
            "type": "shell",
            "command": "sbuild configure ${input:configDR} ${input:platform} ${input:arch} ${input:verbose} ${input:buildNumber} --cmake-args \"${input:cmakeArgs}\"",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Install...",
            "type": "shell",
            "command": "sbuild install ${input:configDR} ${input:platform} ${input:arch} ${input:installPrefix} ${input:installComponent} ${input:systemInstall}",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Test...",
            "type": "shell",
            "command": "sbuild test ${input:configDR} ${input:platform} ${input:arch} ${input:testMode} ${input:outputOnFailure} ${input:jobs} ${input:verbose}",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Test: Filter...",
            "type": "shell",
            "command": "sbuild test ${input:configDR} ${input:platform} ${input:arch} --filter ${input:testPattern} ${input:testMode} ${input:outputOnFailure} ${input:jobs} ${input:verbose}",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Package...",
            "type": "shell",
            "command": "sbuild package ${input:configDRA} ${input:platform} ${input:arch} ${input:packageGenerator} ${input:packageFresh} ${input:verbose} ${input:jobs}",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        },
        {
            "label": "Serve...",
            "type": "shell",
            "command": "sbuild serve --platform wasm ${input:configDR} ${input:serveProtocol} ${input:port}",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "Doctor...",
            "type": "shell",
            "command": "sbuild doctor ${input:doctorVerbose}",
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "configDRA",
            "type": "pickString",
            "description": "Configuration",
            "options": [
                { "label": "Debug",   "value": "" },
                { "label": "Release", "value": "--release" },
                { "label": "All",     "value": "--all" }
            ],
            "default": ""
        },
        {
            "id": "configDR",
            "type": "pickString",
            "description": "Configuration",
            "options": [
                { "label": "Debug",   "value": "" },
                { "label": "Release", "value": "--release" }
            ],
            "default": ""
        },
        {
            "id": "platform",
            "type": "pickString",
            "description": "Platform",
            "options": [
                { "label": "Native",      "value": "" },
                { "label": "WebAssembly", "value": "--platform wasm" }
            ],
            "default": ""
        },
        {
            "id": "arch",
            "type": "pickString",
            "description": "Target architecture",
            "options": [
                { "label": "Default",  "value": "" },
                { "label": "x86",      "value": "--arch x86" },
                { "label": "x64",      "value": "--arch x64" },
                { "label": "arm64",    "value": "--arch arm64" }
            ],
            "default": ""
        },
        {
            "id": "buildClean",
            "type": "pickString",
            "description": "Clean before build?",
            "options": [
                { "label": "No",  "value": "" },
                { "label": "Yes", "value": "--clean" }
            ],
            "default": ""
        },
        {
            "id": "testMode",
            "type": "pickString",
            "description": "Test mode",
            "options": [
                { "label": "Normal",        "value": "" },
                { "label": "Verbose",       "value": "--test-verbose" },
                { "label": "Rerun Failed",  "value": "--rerun-failed" }
            ],
            "default": ""
        },
        {
            "id": "testPattern",
            "type": "promptString",
            "description": "Test filter regex (e.g. 'App.*')",
            "default": ""
        },
        {
            "id": "packageGenerator",
            "type": "pickString",
            "description": "Package generator",
            "options": [
                { "label": "All",  "value": "" },
                { "label": "NSIS", "value": "--generator NSIS" },
                { "label": "IFW",  "value": "--generator IFW" },
                { "label": "ZIP",  "value": "--generator ZIP" }
            ],
            "default": ""
        },
        {
            "id": "packageFresh",
            "type": "pickString",
            "description": "Fresh build before packaging?",
            "options": [
                { "label": "No",  "value": "" },
                { "label": "Yes", "value": "--fresh" }
            ],
            "default": ""
        },
        {
            "id": "serveProtocol",
            "type": "pickString",
            "description": "Protocol",
            "options": [
                { "label": "HTTP",  "value": "" },
                { "label": "HTTPS", "value": "--https" }
            ],
            "default": ""
        },
        {
            "id": "doctorVerbose",
            "type": "pickString",
            "description": "Verbosity",
            "options": [
                { "label": "Normal",  "value": "" },
                { "label": "Verbose", "value": "--verbose" }
            ],
            "default": ""
        },
        {
            "id": "verbose",
            "type": "pickString",
            "description": "Verbose output?",
            "options": [
                { "label": "No",  "value": "" },
                { "label": "Yes", "value": "--verbose" }
            ],
            "default": ""
        },
        {
            "id": "jobs",
            "type": "pickString",
            "description": "Parallel jobs",
            "options": [
                { "label": "Default (CPU count)", "value": "" },
                { "label": "1 job",  "value": "--jobs 1" },
                { "label": "2 jobs", "value": "--jobs 2" },
                { "label": "4 jobs", "value": "--jobs 4" },
                { "label": "8 jobs", "value": "--jobs 8" }
            ],
            "default": ""
        },
        {
            "id": "outputOnFailure",
            "type": "pickString",
            "description": "Show test output on failure?",
            "options": [
                { "label": "Yes (default)", "value": "" },
                { "label": "No",            "value": "--no-output-on-failure" }
            ],
            "default": ""
        },
        {
            "id": "systemInstall",
            "type": "pickString",
            "description": "Install to system location?",
            "options": [
                { "label": "No",  "value": "" },
                { "label": "Yes", "value": "--system-install" }
            ],
            "default": ""
        },
        {
            "id": "buildNumber",
            "type": "promptString",
            "description": "Build number override (e.g. --build-number 42, leave empty for auto)",
            "default": ""
        },
        {
            "id": "cmakeArgs",
            "type": "promptString",
            "description": "Extra CMake defines (e.g. -DFOO=ON, leave empty for none)",
            "default": ""
        },
        {
            "id": "installPrefix",
            "type": "promptString",
            "description": "Install prefix (e.g. --prefix dist, leave empty for default)",
            "default": ""
        },
        {
            "id": "installComponent",
            "type": "promptString",
            "description": "Component (e.g. --component Runtime, leave empty for all)",
            "default": ""
        },
        {
            "id": "port",
            "type": "promptString",
            "description": "Custom port (e.g. --port 9000, leave empty for default)",
            "default": ""
        }
    ]
}
